{
  "name": "process-ai",
  "version": "0.2.1",
  "description": "Framework method-agnóstico de mapeamento de processos ponta-a-ponta — equipe de agentes IA (Déa+Bento+Miguel+Júlia+Zanoni) que conduz o usuário por Q&A até documentar o processo completo (SIPOC→hierarquia→BPMN→POPs) com confiança 🟢🟡🔴 verificável e rastreabilidade bidirecional.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "process-ai": "bin/process-ai.ts",
    "process-ai-bootstrap": "bin/bootstrap.ts"
  },
  "main": "toolkit/src/commit.ts",
  "files": [
    "bin/postinstall.js",
    "bin/",
    "toolkit/",
    "skills/",
    "method-packs/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "dev": "node bin/bootstrap.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "process-mapping",
    "bpmn",
    "sipoc",
    "process-discovery",
    "claude-code",
    "agent-pipeline",
    "hexagonal-architecture",
    "business-process",
    "pop",
    "confidence-markers"
  ],
  "author": "Sandoval Medeiros",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/process-ai/process-ai"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "process-ai": "^0.2.0"
  }
}
